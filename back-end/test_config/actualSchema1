-- VIEWS

-- VIEW: public.item_all
SELECT i.id,
    i.name AS item_name,
    b.name AS brand_name,
    i.quantity,
    i.warranty_months,
    i.mrp AS price,
    s.name AS subcategory_name,
    i.total_items_sold
   FROM ((items i
     LEFT JOIN brands b ON ((i.brand_id = b.id)))
     LEFT JOIN subcategories s ON ((i.subcategory_id = s.id)));

-- VIEW: public.item_full_details
SELECT i.id,
